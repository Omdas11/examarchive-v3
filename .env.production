# Production build-time env for the Cloudflare Worker build.
# NEXT_PUBLIC_* vars are inlined by Next.js at build time, so they must be
# present here (or in the build shell env). This key is PUBLIC by design:
# it is embedded in every page's HTML on the live site and only identifies
# the Turnstile widget. The secret key is NEVER in this file — it is set
# as a Worker secret in the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADrA71sUOV9yI3zX
