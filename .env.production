# Production build-time env for the Cloudflare Worker build.
# NEXT_PUBLIC_* vars are inlined by Next.js at build time, so they must be
# present here (or in the build shell env). These keys are PUBLIC by design:
# they are embedded in every page's HTML on the live site. The Turnstile
# site key only identifies the widget; the GA measurement ID only identifies
# the Analytics property. Secrets are NEVER in this file — they are set
# as Worker secrets in the Cloudflare dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADrA71sUOV9yI3zX
# GA4 — was in Vercel env vars on the old stack, lost in the Cloudflare
# move (2026-11-18); without it the GoogleAnalytics component renders
# nothing and GA recorded zero sessions from Nov 19. Restored 2026-11-19.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FY13YB9STR
